{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infotech-jakarta.local/schemas/event-extraction-result-v1.json",
  "title": "EventExtractionResult v1",
  "type": "object",
  "required": ["schema_version", "source_post_id", "classification", "candidates", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_post_id": {"type": "string", "minLength": 1},
    "classification": {"enum": ["event", "non_event", "ambiguous"]},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/eventCandidate"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "evidence": {
      "type": "object",
      "required": ["field", "source", "media_index", "text"],
      "properties": {
        "field": {
          "enum": [
            "event_name", "start_date", "end_date", "start_time", "end_time",
            "format", "venue", "city_area", "region", "organizer", "price_text",
            "registration_url", "deadline", "tech_relevant", "jabodetabek_relevant"
          ]
        },
        "source": {"enum": ["caption", "image", "video_frame"]},
        "media_index": {"type": ["integer", "null"], "minimum": 1},
        "text": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "eventCandidate": {
      "type": "object",
      "required": [
        "candidate_index", "event_name", "start_date", "end_date", "start_time",
        "end_time", "timezone", "format", "venue", "city_area", "region",
        "organizer", "price_text", "registration_url", "deadline",
        "tech_relevant", "jabodetabek_relevant", "publication_readiness", "evidence"
      ],
      "properties": {
        "candidate_index": {"type": "integer", "minimum": 1},
        "event_name": {"type": "string", "minLength": 1},
        "start_date": {"type": ["string", "null"], "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"},
        "start_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "end_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "timezone": {"enum": ["Asia/Jakarta", null]},
        "format": {"enum": ["offline", "online", "hybrid", "unknown"]},
        "venue": {"$ref": "#/$defs/nullableString"},
        "city_area": {"$ref": "#/$defs/nullableString"},
        "region": {"$ref": "#/$defs/nullableString"},
        "organizer": {"$ref": "#/$defs/nullableString"},
        "price_text": {"$ref": "#/$defs/nullableString"},
        "registration_url": {"type": ["string", "null"], "format": "uri"},
        "deadline": {"type": ["string", "null"], "format": "date-time"},
        "tech_relevant": {"type": ["boolean", "null"]},
        "jabodetabek_relevant": {"type": ["boolean", "null"]},
        "publication_readiness": {"enum": ["ready", "review_required", "insufficient_details"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    }
  }
}
